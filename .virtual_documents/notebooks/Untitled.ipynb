# Ensure last_cycle is a valid dataframe
last_cycle = consumers_merged[consumers_merged['cycle'] == max(consumers_merged['cycle'])]

# Define the bins and labels
bins = [0, 25, 50, 75, 100, 125, float('inf')]
labels = ['0-25', '25-50', '50-75', '75-100', '100-125', '>125']

# Create a new column for KL divergence bins
last_cycle['kl_bin'] = pd.cut(last_cycle['accumulated_kl_divergence'], bins=bins, labels=labels, right=False)


last_cycle.head()


# Group by highest genre and KL divergence bins, and count occurrences
grouped = last_cycle.groupby(['highest_genre', 'kl_bin']).size().unstack(fill_value=0)


# Convert counts to percentages
percentages = grouped.div(grouped.sum(axis=1), axis=0) * 100


# Add the total counts as a new column
grouped['Total Count'] = grouped.sum(axis=1)


print(grouped)


kl_bin_columns = ['0-25', '25-50', '50-75', '75-100', '100-125', '>125']

# Divide each kl_bin value by 'Total Count' and multiply by 100 to convert to percentages
for column in kl_bin_columns:
    grouped[column] = (grouped[column] / grouped['Total Count']) * 100


grouped


import matplotlib.pyplot as plt
import seaborn as sns

# Assuming 'grouped_reset' is the DataFrame with percentages
# Set the 'highest_genre' as index and 'kl_bin' as columns
pivot_df = grouped.drop(columns='Total Count')

# Create the heatmap
plt.figure(figsize=(12, 10))
sns.heatmap(pivot_df, annot=True, fmt=".2f", cmap="YlGnBu", cbar_kws={'label': 'Percentage'}, xticklabels=pivot_df.columns, yticklabels=pivot_df.index)
