# Plot a stacked bar chart
pivot_df.plot(kind='bar', stacked=True, figsize=(12, 8), colormap='viridis')

plt.title("Stacked Bar Plot of KL Divergence Percentages by Genre and Bin")
plt.xlabel("Highest Genre")
plt.ylabel("Percentage")
plt.xticks(rotation=90)
plt.legend(title="KL Divergence Bins", bbox_to_anchor=(1.05, 1), loc='upper left')
