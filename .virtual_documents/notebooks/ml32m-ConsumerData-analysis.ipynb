from scipy.stats import f_oneway, kruskal

# Group the satisfaction scores by genre
groups = [group['satisfaction_score'].values for name, group in consumers_merged[consumers_merged['cycle'] == min(consumers_merged['cycle'])].groupby('highest_genre')]

# Perform ANOVA
anova_result = f_oneway(*groups)
print("ANOVA result:")
print(f"F-statistic: {anova_result.statistic}, p-value: {anova_result.pvalue}")

# Perform Kruskal-Wallis H-test
kruskal_result = kruskal(*groups)
print("\nKruskal-Wallis H-test result:")
print(f"H-statistic: {kruskal_result.statistic}, p-value: {kruskal_result.pvalue}")





last_cycle = consumers_data[consumers_data['cycle'] == max(consumers_data['cycle'])]


last_cycle['kl_divergence'].describe()


last_cycle['kl_divergence'].hist(bins=100)


thresholds = [2.5, 5.0, 7.5, 10.0, 12.5]

for t in thresholds:
    df = last_cycle[last_cycle['kl_divergence'] >= t]
    print(t, ":", len(df), df['satisfaction_score'].median())


genre_historical_df = pd.read_csv('consumer_historical_distribution.csv', index_col=0)
# get only the main genre
max_genre_historical_df = pd.DataFrame({
    'consumer_id': genre_historical_df.index,
    'highest_genre': genre_historical_df.idxmax(axis=1)
})


max_genre_historical_df


df = last_cycle.merge(max_genre_historical_df, on="consumer_id")


df


genres = list(df['highest_genre'].unique())


# Define the bins and labels
bins = [0, 2.5, 5.0, 7.5, 10, 12.5, float('inf')]
labels = ['0-2.5', '2.5-5.0', '5.0-7.5', '7.5-10', '10-12.5', '>12.5']

# Create a new column for KL divergence bins
df['kl_bin'] = pd.cut(df['kl_divergence'], bins=bins, labels=labels, right=False)

# Group by highest genre and KL divergence bins, and count occurrences
grouped = df.groupby(['highest_genre', 'kl_bin']).size().unstack(fill_value=0)

# Convert counts to percentages
percentages = grouped.div(grouped.sum(axis=1), axis=0) * 100

# Add the total counts as a new column
grouped['Total Count'] = grouped.sum(axis=1)

# Move 'Total Count' to the beginning of the DataFrame
result = grouped[['Total Count']].join(percentages)

# Display the result
result


# Calculate cumulative percentages for values above each bin
cumulative_percentages = percentages.iloc[:, ::-1].cumsum(axis=1).iloc[:, ::-1]

# Add the total counts to the cumulative percentages DataFrame
cumulative_percentages_with_count = grouped[['Total Count']].join(cumulative_percentages)

# Rename the columns to reflect "greater than" bins
cumulative_percentages_with_count.columns = (
    ['Total Count'] + 
    ['> ' + label.split('-')[0] for label in labels]
)

# Display the result
cumulative_percentages_with_count.reset_index(inplace=True)


# Create a new figure and axis
fig, ax = plt.subplots(figsize=(8, 4))  # Adjust size as needed
ax.axis('tight')
ax.axis('off')

# Add a table to the plot
table_data = ax.table(
    cellText=cumulative_percentages_with_count.values,
    colLabels=cumulative_percentages_with_count.columns,
    cellLoc='center',
    loc='center'
)

# Save the table as an image
plt.savefig('mytable.png', bbox_inches='tight', dpi=300)
plt.close(fig)



